# Optional credentials for hosted script providers and cloud visuals
XAI_API_KEY=
OPENAI_API_KEY=

# Cloud visual model configuration
OPENAI_IMAGE_MODEL=gpt-image-1
OPENAI_IMAGE_QUALITY=low
XAI_VIDEO_MODEL=grok-imagine-video

# Required for the approval gate. TELEGRAM_DEFAULT_CHAT_ID is accepted as an
# alternative to TELEGRAM_CHAT_ID.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_DEFAULT_CHAT_ID=

# Queue and local state
JOB_QUEUE_URL=http://100.123.208.90:8787
JOB_QUEUE_CLIENT_ROOT=/home/alireza/content-factory/queue
NEWS_PIPELINE_DB=/home/alireza/content-factory/pipeline/data/pipeline.sqlite3
NEWS_PIPELINE_WORK_ROOT=/home/alireza/content-factory/pipeline/runs
NEWS_TOPIC=

# API, polling, retry, and approval timeouts (seconds)
VIDEO_POLL_INTERVAL=5
VIDEO_POLL_TIMEOUT=2700
QUEUE_POLL_INTERVAL=2
QUEUE_STAGE_TIMEOUT=21600
STAGE_RETRY_BASE_SECONDS=2
# Per-chunk network inactivity limit for streaming script calls.
API_REQUEST_TIMEOUT=120
TELEGRAM_POLL_TIMEOUT=25
APPROVAL_WAIT_TIMEOUT=0

# Optional fallback credential files. The process environment takes precedence,
# followed by pipeline/.env, then the fallback files.
HERMES_ENV_FILE=/home/alireza/.hermes/.env
TELEGRAM_ENV_FILE=/home/alireza/signal-terminal/.env
