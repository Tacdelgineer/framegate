[Unit]
Description=DGX Hermes media pipeline worker
Wants=network-online.target tailscaled.service docker.service ollama.service
After=network-online.target tailscaled.service docker.service ollama.service

[Service]
Type=simple
User=xxfactionsxx
Group=xxfactionsxx
SupplementaryGroups=docker
WorkingDirectory=/home/xxfactionsxx/pipeline-worker
EnvironmentFile=/etc/pipeline-worker.env
ExecStartPre=/usr/bin/test -f /home/xxfactionsxx/pipeline-worker/uv.lock
ExecStartPre=/home/xxfactionsxx/.local/bin/uv lock --check --offline
ExecStart=/home/xxfactionsxx/pipeline-worker/.venv/bin/python /home/xxfactionsxx/pipeline-worker/pipeline_worker.py
Restart=always
RestartSec=5
TimeoutStopSec=30
UMask=0027
StateDirectory=pipeline-worker
ReadWritePaths=/srv/ai/assets/pipeline-worker /srv/ai/outputs /var/lib/pipeline-worker
StandardOutput=append:/var/log/pipeline-worker.log
StandardError=append:/var/log/pipeline-worker.log

[Install]
WantedBy=multi-user.target

